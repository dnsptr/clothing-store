{
  "name": "clothing-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:catalog && npm run test:delivery",
    "test:catalog": "node --test scripts/tests/medusa-catalog.test.mjs",
    "test:delivery": "node --test scripts/tests/cdek-client.test.mjs scripts/tests/cdek-check.test.mjs scripts/tests/yandex-client.test.mjs scripts/tests/checkout-quote.test.mjs",
    "backend:dev": "npm --prefix medusa-prototype run backend:dev",
    "backend:build": "npm --prefix medusa-prototype run build",
    "backend:catalog": "npm --prefix medusa-prototype run catalog:import",
    "backend:lint": "npm --prefix medusa-prototype run lint",
    "integrations:check:cdek": "node --env-file=medusa-prototype/apps/backend/.env.integrations.local medusa-prototype/scripts/check-cdek.mjs",
    "integrations:check:tbank": "node --env-file=medusa-prototype/apps/backend/.env.integrations.local medusa-prototype/scripts/check-tbank.mjs",
    "integrations:check:yandex": "node --env-file=medusa-prototype/apps/backend/.env.integrations.local medusa-prototype/scripts/check-yandex.mjs",
    "integrations:check:pochta": "node --env-file=medusa-prototype/apps/backend/.env.integrations.local medusa-prototype/scripts/check-pochta.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
