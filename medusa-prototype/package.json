{
  "name": "medusa-prototype",
  "private": false,
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "catalog:import": "npm --workspace @dtc/backend run catalog:import",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "ajv": "^8.20.0",
    "eslint": {
      "ajv": "^6.14.0"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.14.0"
    },
    "axios": "^1.20.0",
    "compression": "^1.8.2",
    "fast-uri": "^3.1.8",
    "lodash": "^4.18.1",
    "multer": "^2.4.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "source-map-js": "^1.2.2",
    "@grpc/grpc-js": "^1.14.5",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "@graphql-tools/utils": "^12.0.3"
  }
}
