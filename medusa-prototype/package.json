{
  "name": "medusa-prototype",
  "private": false,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "catalog:import": "npm --workspace @dtc/backend run catalog:import",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.4",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "@rushstack/node-core-library": {
      "ajv": "^8.20.0"
    },
    "bullmq": {
      "uuid": "11.1.1"
    },
    "eslint": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "test-exclude": {
      "minimatch": "11.0.5",
      "glob": "14.0.2"
    },
    "jest-config": {
      "glob": "14.0.2"
    },
    "jest-runtime": {
      "glob": "14.0.2"
    },
    "@jest/reporters": {
      "glob": "14.0.2"
    }
  }
}
