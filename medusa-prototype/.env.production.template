BACKEND_HOST=replace-with-your-host
# Real origin-facing source CIDRs from the HTTPS load balancer, not its public DNS IP.
HTTPS_PROXY_CIDRS=replace-with-verified-load-balancer-source-cidrs

PUBLIC_BACKEND_URL=https://replace-with-your-host
STOREFRONT_URL=https://www.mariomikke.shop

POSTGRES_PASSWORD=replace-with-a-random-hex-value
REDIS_PASSWORD=replace-with-a-random-hex-value
JWT_SECRET=replace-with-a-random-hex-value
COOKIE_SECRET=replace-with-a-random-hex-value
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-64-character-hex-value

# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
#
# ВНИМАНИЕ: каждый `$` в хеше нужно удвоить. Compose раскрывает `$VAR` в
# значениях этого файла, а bcrypt-хеш всегда выглядит как `$2a$14$<соль+хеш>` —
# кусок после третьего `$` compose считает именем переменной и заменяет пустой
# строкой. В Caddy уходит обрубок, и ни один пароль к нему не подойдёт.
# Было `$2a$14$e4tdUX...`, стало `$2a$14/f65tVcyCy6i`. `$$` — экранирование
# литерального `$`. `scripts/deploy.sh` делает это сам.
ADMIN_BASIC_AUTH_HASH=replace-with-caddy-hash-password-output-with-every-dollar-doubled

STORE_CORS=https://mariomikke.shop,https://www.mariomikke.shop
ADMIN_CORS=https://replace-with-your-host
AUTH_CORS=https://mariomikke.shop,https://www.mariomikke.shop,https://replace-with-your-host

# --- CDEK --------------------------------------------------------------------
# Production accepts only https://api.cdek.ru/v2. Keep credentials unset while
# disabled; enabling CDEK requires credentials, origin city and fixed buyer fees.
CDEK_ENABLED=false
# CDEK_API_BASE_URL=https://api.cdek.ru/v2
# CDEK_CLIENT_ID=
# CDEK_CLIENT_SECRET=
# CDEK_FROM_CITY_CODE=       # diagnostic default city; checkout uses each point's city_code
# Пункты сдачи и пункт по умолчанию: админка → «Пункты сдачи» → склад отправления.
# Согласованные покупательские цены обоих способов обязательны даже если
# ключи СДЭК уже настроены. Расход перевозчика рассчитывается отдельно.
CDEK_PVZ_PRICE_RUB=350
CDEK_COURIER_PRICE_RUB=490

# --- Yandex Delivery ---------------------------------------------------------
# Supports Yandex Market pickup points and terminals via Platform API.
# Enabling requires a token, the actual source station ID and an agreed positive buyer price.
# No real tariff or shipment is confirmed by these settings alone.
YANDEX_DELIVERY_ENABLED=false
# YANDEX_DELIVERY_TOKEN=
# Станции сдачи: админка → «Пункты сдачи», не глобальная переменная окружения.
# Fixed buyer price in RUB; carrier expenses are calculated and saved separately.
YANDEX_DELIVERY_PVZ_PRICE_RUB=350
# YANDEX_DELIVERY_API_BASE_URL=https://b2b-authproxy.taxi.yandex.net/api/b2b/platform
# YANDEX_CHECK_SOURCE_STATION_ID=  # read-only scripts/check-yandex.mjs only; not backend routing

# --- Russian Post ------------------------------------------------------------
# Supports both Parcel Online to a post office and Courier Online to the door.
POCHTA_ENABLED=false
# POCHTA_ACCESS_TOKEN=
# POCHTA_USER_KEY=
# POCHTA_API_BASE_URL=https://otpravka-api.pochta.ru/1.0
# POCHTA_FROM_INDEX=         # actual dispatch postcode; required when POCHTA_ENABLED=true

# --- Свой курьер внутри МКАД -------------------------------------------------
# Акция: 0 ₽ внутри МКАД до 31.12.2026 включительно (московское время).
# После акции нулевой тариф недоступен; новый платный тариф нужно согласовать.
# Без явного включения и обоих ключей DaData собственный курьер недоступен.
OWN_COURIER_ENABLED=false
OWN_COURIER_PRICE_RUB=0
# Ключи храните только в закрытом .env.production на сервере.
# DADATA_API_KEY=
# DADATA_SECRET_KEY=
# --- Т-Банк ------------------------------------------------------------------
# При `false` все остальные TBANK_* должны быть пустыми или закомментированными.
# `true` включает fail-closed проверку полного набора до миграций и регистрации.
# Значения URL ограничены этими source-controlled адресами и точными путями.
#
TBANK_ENABLED=false
# TBANK_PAYMENT_PROVIDER_ID=pp_tbank_tbank
# TBANK_TERMINAL_KEY=
# TBANK_PASSWORD=
# Generate independently with: openssl rand -base64 32
# TBANK_RECEIPT_SNAPSHOT_SECRET=
#
# DEMO-терминал и боевые платежи используют securepay. Боевой терминал в
# изолированной тестовой среде использует rest-api-test и белый список IP.
# DEMO terminal: TBANK_API_BASE_URL=https://securepay.tinkoff.ru/v2
# Live terminal in the allow-listed test environment: TBANK_API_BASE_URL=https://rest-api-test.tinkoff.ru/v2
#
# Куда банк вернёт покупателя и куда пришлёт нотификацию. NotificationURL
# обязан быть доступен извне, иначе оплата не подтвердится.
# TBANK_SUCCESS_URL=https://www.mariomikke.shop/checkout/success
# TBANK_FAIL_URL=https://www.mariomikke.shop/checkout/fail
# TBANK_NOTIFICATION_URL=https://api.mariomikke.shop/hooks/payment/tbank

# --- Уведомления -------------------------------------------------------------
# Для уведомлений сотрудников нужны оба значения: токен регистрирует Telegram-
# провайдера, ID чата указывает получателя подписчику на подтверждённый заказ.
# Без ID чата сообщение не отправляется; без токена провайдер не регистрируется.
# Оставьте оба незаданными, пока Telegram не готов к работе.
# Токен получают у @BotFather. Для группы нужен её ID (обычно отрицательный);
# добавьте бота в группу и разрешите отправку сообщений до включения.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Письма покупателям после подтверждённой оплаты -------------------------
# Заполните все SMTP_HOST, SMTP_USER, SMTP_PASSWORD, SMTP_FROM в реальном
# .env.production. Без полного набора email-уведомления остаются только в логе.
# Пароль приложения/SMTP храните только в .env.production (права 600);
# SMTP_FROM должен быть разрешён провайдером для SMTP_USER.
# 465 — TLS сразу после соединения; 587 — обязательный STARTTLS.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Mario Mikke <shop@example.ru>
