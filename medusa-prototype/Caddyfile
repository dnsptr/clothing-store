{$BACKEND_HOST:api.mariomikke.shop} {
	encode zstd gzip

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@untrusted not remote_ip {$HTTPS_PROXY_CIDRS}
	@insecure {
		not header X-Forwarded-Proto https
		not path /health
	}
	@admin path /app* /auth/user/*
	@uploads path /admin/uploads*
	@media path /static/*

	route {
		# Trust the scheme only from the verified HTTPS load balancer.
		respond @untrusted "Untrusted ingress" 403
		redir @insecure https://{$BACKEND_HOST}{uri} 308
		request_body @uploads {
			max_size 22MiB
		}
		header @media Content-Security-Policy "sandbox; default-src 'none'"
		basic_auth @admin {
			admin {$ADMIN_BASIC_AUTH_HASH}
		}
		reverse_proxy 127.0.0.1:9000 {
			header_up X-Forwarded-Proto https
		}
	}
}
