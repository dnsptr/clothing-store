{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "catalog:import": "medusa exec ./src/scripts/import-mario-mikke.ts",
    "catalog:import:customer": "medusa exec ./src/scripts/import-customer-catalog.ts",
    "content:seed": "medusa exec ./src/scripts/seed-home-content.ts",
    "lint": "medusa lint",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:checkout:offline": "node src/scripts/run-offline-checkout.cjs"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.4",
    "@medusajs/admin-shared": "2.22.4",
    "@medusajs/cache-redis": "2.22.4",
    "@medusajs/caching": "2.22.4",
    "@medusajs/cli": "2.22.4",
    "@medusajs/dashboard": "2.22.4",
    "@medusajs/draft-order": "2.22.4",
    "@medusajs/event-bus-redis": "2.22.4",
    "@medusajs/framework": "2.22.4",
    "@medusajs/js-sdk": "2.22.4",
    "@medusajs/locking": "2.22.4",
    "@medusajs/locking-redis": "2.22.4",
    "@medusajs/medusa": "2.22.4",
    "@medusajs/ui": "4.2.11",
    "@medusajs/workflow-engine-redis": "2.22.4",
    "@tanstack/react-query": "5.64.2",
    "nodemailer": "^10.3.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.22.4",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jest": "^30.5.2",
    "pg-god": "^1.0.12",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "packageManager": "npm@11.19.1"
}
