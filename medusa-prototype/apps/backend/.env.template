MEDUSA_ADMIN_ONBOARDING_TYPE=default
STOREFRONT_URL=http://localhost:3000
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:9000
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret
COOKIE_SECRET=replace-with-a-random-secret
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-64-character-hex-key
DATABASE_URL=postgres://medusa:medusa@localhost:5433/medusa_backend

# --- Т-Банк (опционально в разработке) ---------------------------------------
# Провайдер регистрируется только при заданных TBANK_TERMINAL_KEY и
# TBANK_PASSWORD. Без них бэкенд стартует как раньше — это рабочее состояние
# для разработки каталога и корзины.
# TBANK_TERMINAL_KEY=
# TBANK_PASSWORD=
# TBANK_API_BASE_URL=https://rest-api-test.tinkoff.ru/v2
# TBANK_SUCCESS_URL=http://localhost:3000/checkout/success
# TBANK_FAIL_URL=http://localhost:3000/checkout/fail
# TBANK_NOTIFICATION_URL=

# --- Уведомления (опционально) -----------------------------------------------
# Без TELEGRAM_CHAT_ID подписчик на order.placed ничего не отправляет.
# Провайдер `local` пишет уведомления в лог, поэтому цепочку можно проверить и
# без токена.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
