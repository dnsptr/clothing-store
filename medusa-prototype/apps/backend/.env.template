MEDUSA_ADMIN_ONBOARDING_TYPE=default
STOREFRONT_URL=http://localhost:3000
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:9000
# Must carry the password from docker-compose.yml, which starts Redis with
# `--requirepass medusa`. Without it the backend fails to connect.
REDIS_URL=redis://:medusa@localhost:6379

# Public origin of this backend. Uploaded files record an absolute URL built
# from it, so it has to be right before the first upload. Locally the default
# below matches `medusa develop`; in production deploy.sh sets it.
PUBLIC_BACKEND_URL=http://localhost:9000
JWT_SECRET=replace-with-a-random-secret
COOKIE_SECRET=replace-with-a-random-secret
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-64-character-hex-key
DATABASE_URL=postgres://medusa:medusa@localhost:5433/medusa_backend

# --- CDEK API ---------------------------------------------------------------
# Keep credentials only in .env (which is ignored by Git). Use the EDU URL for
# sandbox credentials. Use https://api.cdek.ru/v2 only for production keys.
# The check command performs only token, city and tariff requests; it never
# creates a shipment.
CDEK_ENABLED=false
# CDEK_CLIENT_ID=
# CDEK_CLIENT_SECRET=
# CDEK_API_BASE_URL=https://api.edu.cdek.ru/v2
# CDEK_FROM_CITY_CODE=       # diagnostic default city; checkout uses each point's city_code
# Пункты сдачи и пункт по умолчанию: админка → «Пункты сдачи» → склад отправления.
# CDEK_TO_CITY_CODE=137
CDEK_PVZ_PRICE_RUB=350
CDEK_COURIER_PRICE_RUB=490

# --- Yandex Delivery (optional in development) -------------------------------
# Яндекс Маркет ПВЗ и постаматы доступны только при явно включённой интеграции.
# Укажите подтверждённый ID собственного склада отправки в Платформе Яндекс Доставки.
YANDEX_DELIVERY_ENABLED=false
# YANDEX_DELIVERY_TOKEN=
# Станции сдачи: админка → «Пункты сдачи», не глобальная переменная окружения.
# YANDEX_DELIVERY_API_BASE_URL=https://b2b-authproxy.taxi.yandex.net/api/b2b/platform
# YANDEX_CHECK_SOURCE_STATION_ID=  # read-only scripts/check-yandex.mjs only; not backend routing
YANDEX_DELIVERY_PVZ_PRICE_RUB=350

# --- Russian Post delivery (optional in development) -------------------------
# Supports Parcel Online to a post office and Courier Online to the door.
POCHTA_ENABLED=false
# POCHTA_ACCESS_TOKEN=
# POCHTA_USER_KEY=
# POCHTA_API_BASE_URL=https://otpravka-api.pochta.ru/1.0
# POCHTA_FROM_INDEX=         # actual dispatch postcode; required when POCHTA_ENABLED=true

# --- Own courier inside MKAD (server-side DaData Clean address) --------------
# Free inside MKAD through 31 December 2026 inclusive (Moscow time).
# Zero-priced quotes are unavailable after the promotion; agree a new tariff.
# Both credentials and explicit enablement are required.
OWN_COURIER_ENABLED=false
OWN_COURIER_PRICE_RUB=0
# DADATA_API_KEY=
# DADATA_SECRET_KEY=

# --- Т-Банк (опционально в разработке) ---------------------------------------
# По умолчанию провайдер явно отключён. При `true` обязательны все значения;
# разрешены только опубликованные ниже HTTPS endpoints и точные callback paths.
TBANK_ENABLED=false
# TBANK_PAYMENT_PROVIDER_ID=pp_tbank_tbank
# TBANK_TERMINAL_KEY=
# TBANK_PASSWORD=
# Generate independently with: openssl rand -base64 32
# TBANK_RECEIPT_SNAPSHOT_SECRET=
# DEMO terminal: https://securepay.tinkoff.ru/v2
# Live terminal in the allow-listed test environment: https://rest-api-test.tinkoff.ru/v2
# TBANK_API_BASE_URL=https://securepay.tinkoff.ru/v2
# TBANK_SUCCESS_URL=https://www.mariomikke.shop/checkout/success
# TBANK_FAIL_URL=https://www.mariomikke.shop/checkout/fail
# TBANK_NOTIFICATION_URL=https://api.mariomikke.shop/hooks/payment/tbank

# --- Уведомления (опционально) -----------------------------------------------
# Telegram и email сотрудников независимо получают событие tbank.order.paid.
# Без получателя соответствующее уведомление сотрудникам не отправляется.
# Без SMTP провайдер `local` пишет email в лог, а не доставляет письмо.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ORDER_NOTIFICATION_EMAIL=

# --- Почта (опционально в разработке) ----------------------------------------
# Провайдер SMTP регистрируется, только когда заданы все четыре: SMTP_HOST,
# SMTP_USER, SMTP_PASSWORD и SMTP_FROM. Тогда канал `email` переходит к нему, а
# `local` остаётся с `feed`. Без них письмо покупателю уходит в лог провайдера
# `local` — цепочка «заказ → письмо» проверяется без почтового хостинга.
#
# Хостинг — любой с SMTP (Unisender, Mail.ru, Яндекс, свой relay). Порт и режим
# TLS у них разные: 465 — неявный TLS, 587 — STARTTLS. Пустой SMTP_PORT
# означает 587, пустой SMTP_SECURE — «вывести из порта».
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Mario Mikke <shop@example.ru>
