MEDUSA_ADMIN_ONBOARDING_TYPE=default
STOREFRONT_URL=http://localhost:3000
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:9000
# Must carry the password from docker-compose.yml, which starts Redis with
# `--requirepass medusa`. Without it the backend fails to connect.
REDIS_URL=redis://:medusa@localhost:6379

# Public origin of this backend. Uploaded files record an absolute URL built
# from it, so it has to be right before the first upload. Locally the default
# below matches `medusa develop`; in production deploy.sh sets it.
PUBLIC_BACKEND_URL=http://localhost:9000
JWT_SECRET=replace-with-a-random-secret
COOKIE_SECRET=replace-with-a-random-secret
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-64-character-hex-key
DATABASE_URL=postgres://medusa:medusa@localhost:5433/medusa_backend
