# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.template
!**/.env.template
!**/.env.production.template
!/medusa-prototype/.env.production.payment-fixture

# local tooling and generated patches
.npm-cache/
.opencode/
.turbo/
*.patch

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local deepwork orchestration state
.slim/
.playwright-mcp/
.omo/
.ignore

# Customer source documents and private operational reports (keep locally).
/docs/company docs/
/docs/filled up/
/docs/info.md
/docs/new_info.md
/docs/*.docx
/docs/*.xlsx
/docs/DEPLOYMENT_2026-09-05.md
/docs/PROJECT_STATUS_AND_LAUNCH_PLAN.md
/docs/FISCALIZATION_ATOL_STATUS.md
/docs/LEGAL_PAGES_REVIEW.md
/docs/CATALOG_PHOTO_RELEASE.md

# Private keys, database backups and source archives. Public legal documents
# under public/legal and public CA certificates (*.crt) remain tracked.
*.key
*.p12
*.pfx
id_rsa
id_ed25519
backups/
*.dump
*.dump.gz
*.sql.gz
*.rar
*.7z
onec-data/
var/onec/
