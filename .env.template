# --- Storefront data source -------------------------------------------------
# Values prefixed with NEXT_PUBLIC_ are inlined into the browser bundle at build
# time. The server prefers the unprefixed variables below and reads them when the
# server process starts, so on Vercel a backend/key change no longer requires a
# rebuild of the bundle — only a redeploy of the environment.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_publishable_key
# Optional. When omitted, the storefront selects the RUB region automatically.
NEXT_PUBLIC_MEDUSA_REGION_ID=

# --- Server-side overrides (optional; take precedence on the server) ---------
# The browser still needs the NEXT_PUBLIC_ values for cart calls it makes
# directly, so these are overrides for server rendering, not replacements.
# DATA_MODE=medusa
# MEDUSA_BACKEND_URL=https://api.mariomikke.shop
# MEDUSA_PUBLISHABLE_KEY=pk_replace_with_publishable_key
# MEDUSA_REGION_ID=

# --- Server target only ------------------------------------------------------
# Absolute base for canonical links and OG images.
# NEXT_PUBLIC_SITE_URL=https://www.mariomikke.shop
# Extra image origins the optimiser may fetch from, comma-separated. Needed once
# media moves to S3 (roadmap 4.1). Build-time only — Next cannot re-read
# `images.remotePatterns` per request.
# MEDIA_ALLOWED_ORIGINS=
