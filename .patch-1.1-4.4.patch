diff --git a/docs/adr/0002-storefront-rendering-model.md b/docs/adr/0002-storefront-rendering-model.md
new file mode 100644
index 0000000..217a9f0
--- /dev/null
+++ b/docs/adr/0002-storefront-rendering-model.md
@@ -0,0 +1,83 @@
+# ADR-002: Модель рендеринга витрины
+
+- **Статус:** принят
+- **Дата:** 2026-07-26
+- **Контекст roadmap:** задача 1.1 (этап P1); разблокирует 4.1 (медиа), 4.5 (SEO)
+- **Связан с:** ADR-001 §6 (режимы данных витрины)
+
+## Контекст
+
+Витрина собиралась в единственном режиме `output: "export"`. Следствия:
+
+1. Страницы товаров существовали только для id, перечисленных в
+   `generateStaticParams()`, а тот возвращал id демо-каталога. Товар, заведённый
+   менеджером в Medusa Admin, **не получал страницы вообще** — не медленную, не
+   пустую, а 404 по прямой ссылке. Это делало админку непригодной для основной
+   операции: завести товар.
+2. `next/image` работал только с `unoptimized: true`.
+3. `NEXT_PUBLIC_*` вшивались в бандл на сборке, поэтому смена ключа или адреса
+   бэкенда требовала пересборки. Именно этот механизм привёл к деградации
+   каталога на проде (roadmap 0.1).
+4. PDP держала костыль: серверный компонент отдавал мок-«оболочку», а клиент
+   заново дорезолвливал товар по handle.
+
+Демо на GitHub Pages при этом остаётся нужным: у него нет сервера.
+
+## Решение
+
+### 1. Две цели сборки вместо одной
+
+- `npm run build` — сервер + ISR. Артефакт Vercel. Значение по умолчанию.
+- `npm run build:pages` (`BUILD_TARGET=pages`) — статический экспорт. Артефакт
+  GitHub Pages. Включает `output: "export"`, `images.unoptimized`,
+  `basePath`/`assetPrefix`.
+
+CI собирает **обе** цели. Регрессия в экспортной цели иначе обнаруживается
+только падением деплоя Pages.
+
+### 2. Страницы товаров генерируются по требованию
+
+На серверной цели `generateStaticParams()` возвращает пустой массив. По
+документации Next 16 это и есть условие ISR-генерации путей в рантайме: любой
+id, включая созданный после деплоя, рендерится при первом обращении и дальше
+отдаётся из кеша. `revalidate = 300`.
+
+Next 16 **не** кеширует `fetch` по умолчанию (в 14 кешировал), поэтому серверные
+чтения каталога явно передают `next.revalidate`; одного сегментного
+`export const revalidate` недостаточно.
+
+### 3. Разграничение 404 и недоступности бэкенда
+
+- Товар отсутствует в Medusa → `notFound()`.
+- Medusa недоступна → контролируемое состояние ошибки, **не** 404 и **не** 500.
+
+404 в этом случае сообщил бы покупателю, что товара не существует, и отравил бы
+ISR-кеш отрицательным ответом для живого товара. Фолбэк на демо-каталог
+запрещён (ADR-001 §6).
+
+### 4. Серверные переменные окружения имеют приоритет
+
+На сервере `MEDUSA_BACKEND_URL` / `MEDUSA_PUBLISHABLE_KEY` / `DATA_MODE`
+перекрывают `NEXT_PUBLIC_*` и читаются при старте процесса. Рендеринг каталога и
+карточек перестаёт зависеть от того, что вшито в бандл.
+
+Ограничение: корзина ходит в Store API из браузера и по-прежнему требует
+публичного ключа в бандле. Перенос этих вызовов за route handler — отдельная
+задача, в этом ADR не решается.
+
+### 5. `images.remotePatterns` остаётся сборочной настройкой
+
+Next не перечитывает её в рантайме. Список выводится из адреса бэкенда плюс
+`MEDIA_ALLOWED_ORIGINS`, чтобы миграция медиа в S3 (4.1) была сменой переменной,
+а не правкой кода. Это единственная оставшаяся сборочная привязка к адресам.
+
+## Последствия
+
+- 4.5 (SEO-пакет) становится осмысленным: появились per-product `metadata`,
+  канонические ссылки и OG. `sitemap`/`robots` — в рамках 4.5.
+- 4.1 (медиа в S3) больше не блокируется отсутствием оптимизации изображений.
+- Демо на Pages сохраняется без изменений в поведении, но собирается другой
+  командой; workflow обновлён.
+- Отказ от `output: "export"` на серверной цели означает, что Vercel-деплой
+  теперь имеет серверную часть: это влияет на биллинг и на требования к
+  мониторингу (4.2).
diff --git a/next.config.ts b/next.config.ts
index ef881f5..08f9cc7 100644
--- a/next.config.ts
+++ b/next.config.ts
@@ -1,25 +1,86 @@
 import type { NextConfig } from "next";

-const githubPagesBasePath =
-  process.env.NEXT_PUBLIC_BASE_PATH ??
-  (process.env.GITHUB_ACTIONS === "true" ? "/clothing-store" : "");
+// Two build targets share this config.
+//
+//   default (Vercel)   — server rendering + ISR. Product pages are produced on
+//                        demand, so a product created in Medusa Admin gets a
+//                        page without a redeploy. next/image optimisation is on.
+//   BUILD_TARGET=pages — static export of the mock demo for GitHub Pages. No
+//                        server, no checkout (README → "Environments").
+//
+// CI builds BOTH targets on purpose: a regression in the export target is
+// otherwise invisible until the Pages deploy fails.
+const isPagesExport = process.env.BUILD_TARGET === "pages";

+// basePath/assetPrefix belong to the Pages export only. On Vercel the app is
+// served from the domain root and a stray basePath would break every asset URL.
+const githubPagesBasePath = isPagesExport
+  ? process.env.NEXT_PUBLIC_BASE_PATH ??
+    (process.env.GITHUB_ACTIONS === "true" ? "/clothing-store" : "")
+  : "";
+
+// Build-time guard for the export target only. In a static export the public
+// variables are inlined into the bundle, so a missing key can only be caught
+// here. On the server target the same variables are read per request
+// (src/lib/medusa.ts) — that is precisely what lets an env change take effect
+// without a rebuild, so a build-time throw there would reintroduce the coupling
+// this change removes. The server target fails loudly at request time instead.
 if (
+  isPagesExport &&
   process.env.NEXT_PUBLIC_DATA_MODE === "medusa" &&
   (!process.env.NEXT_PUBLIC_MEDUSA_BACKEND_URL ||
     !process.env.NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY)
 ) {
   throw new Error(
-    "Medusa mode requires NEXT_PUBLIC_MEDUSA_BACKEND_URL and " +
+    "Static export in medusa mode requires NEXT_PUBLIC_MEDUSA_BACKEND_URL and " +
       "NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY at build time.",
   );
 }

+/**
+ * Hosts the image optimiser is allowed to fetch product media from.
+ *
+ * `remotePatterns` is build-time configuration — Next cannot re-read it per
+ * request — so this is the one place where a backend/CDN move still requires a
+ * redeploy. Derived from the configured backend plus an explicit override list
+ * (`MEDIA_ALLOWED_ORIGINS`, comma-separated) so the S3 migration (task 4.1) is
+ * a variable change rather than a code change.
+ */
+function mediaRemotePatterns() {
+  const origins = [
+    process.env.MEDUSA_BACKEND_URL,
+    process.env.NEXT_PUBLIC_MEDUSA_BACKEND_URL,
+    ...(process.env.MEDIA_ALLOWED_ORIGINS?.split(",") ?? []),
+  ];
+
+  const patterns = new Map<string, { protocol: "http" | "https"; hostname: string; port: string }>();
+  for (const origin of origins) {
+    const trimmed = origin?.trim();
+    if (!trimmed) continue;
+    try {
+      const { protocol, hostname, port } = new URL(trimmed);
+      if (protocol !== "http:" && protocol !== "https:") continue;
+      patterns.set(`${protocol}//${hostname}:${port}`, {
+        protocol: protocol === "https:" ? "https" : "http",
+        hostname,
+        port,
+      });
+    } catch {
+      // A malformed origin must not take the build down; it simply grants no
+      // permission, and the resulting image request fails visibly in review.
+      console.warn(`[next.config] Ignored malformed media origin: ${trimmed}`);
+    }
+  }
+
+  return [...patterns.values()];
+}
+
 const nextConfig: NextConfig = {
-  output: "export",
-  images: {
-    unoptimized: true,
-  },
+  ...(isPagesExport ? { output: "export" as const } : {}),
+  images: isPagesExport
+    ? // No optimiser exists in a static export.
+      { unoptimized: true }
+    : { remotePatterns: mediaRemotePatterns() },
   basePath: githubPagesBasePath || undefined,
   assetPrefix: githubPagesBasePath || undefined,
   env: {
